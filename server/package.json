{
  "name": "ai-appointment-booking",
  "version": "1.0.0",
  "description": "AI Appointment Booking application with React, GraphQL, MongoDB, and API integrations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "develop": "concurrently \"cd server && npm run watch\" \"cd client && npm start\"",
    "setup": "cd server && npm i && cd ../client && npm i",
    "build": "cd client && npm install && npm run build",
    "seed": "cd server && npm run seed"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "appointment",
    "booking",
    "ai",
    "twilio",
    "openai",
    "google-calendar",
    "mern",
    "graphql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "apollo-server-express": "^3.13.0",
    "bcrypt": "^5.1.1",
    "concurrently": "^8.2.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^148.0.0",
    "graphql": "^16.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.1",
    "morgan": "^1.10.0",
    "openai": "^4.97.0",
    "twilio": "^5.6.0"
  }
}
